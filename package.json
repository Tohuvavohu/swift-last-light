{
  "name": "swift-last-light",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc --noEmit --incremental false && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "node --import tsx tests/readiness.mjs",
    "data:update": "tsx scripts/update-data.ts"
  },
  "dependencies": {
    "leaflet": "1.9.4",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "satellite.js": "7.0.0",
    "suncalc": "1.9.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/leaflet": "1.9.21",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/suncalc": "1.9.2",
    "@vitejs/plugin-react": "6.0.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  }
}
